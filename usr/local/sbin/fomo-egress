#!/bin/bash
# fomo egress firewall: own nft table, matches ONLY sockets owned by uids fomo / fomo-signer. Existing rules untouched.
#   fomo-egress apply    create/replace table inet fomo_egress + refresh
#   fomo-egress refresh  resolve allowlisted hosts → add IPs to timed sets
#   fomo-egress status   counters + set sizes
#   fomo-egress remove   delete the table (fomo traffic then unrestricted)
set -euo pipefail
HOSTS=/etc/fomo/egress-hosts.txt
U1=$(id -u fomo); U2=$(id -u fomo-signer 2>/dev/null || echo "$U1")
apply() {
  nft list table inet fomo_egress >/dev/null 2>&1 && nft delete table inet fomo_egress
  nft -f - <<NFT
table inet fomo_egress {
  set dyn4 { type ipv4_addr; flags timeout; timeout 6h; }
  set dyn6 { type ipv6_addr; flags timeout; timeout 6h; }
  set tg4 { type ipv4_addr; flags interval;
    elements = { 149.154.160.0/20, 91.108.4.0/22, 91.108.8.0/22, 91.108.12.0/22, 91.108.16.0/22, 91.108.20.0/22, 91.108.56.0/22, 95.161.64.0/20, 185.76.151.0/24 } }
  set tg6 { type ipv6_addr; flags interval;
    elements = { 2001:67c:4e8::/48, 2001:b28:f23c::/48, 2001:b28:f23d::/48, 2001:b28:f23f::/48 } }
  chain filt {
    oif "lo" accept
    ct state established,related accept
    ip daddr @dyn4 tcp dport { 80, 443 } counter accept
    ip6 daddr @dyn6 tcp dport { 80, 443 } counter accept
    ip daddr @tg4 tcp dport { 80, 443, 5222 } counter accept
    ip6 daddr @tg6 tcp dport { 80, 443, 5222 } counter accept
    limit rate 10/minute log prefix "fomo-egress-drop: " level info
    counter reject with icmpx type admin-prohibited
  }
  chain out {
    type filter hook output priority 0; policy accept;
    # ONLY packets whose socket is positively owned by a fomo uid are filtered; everything else (other users,
    # kernel-generated packets without a socket) is untouched.
    meta skuid { $U1, $U2 } jump filt
  }
}
NFT
  refresh
}
refresh() {
  local n4=0 n6=0
  while read -r h; do
    h="${h%%#*}"; h="$(echo "$h" | tr -d '[:space:]')"; [ -z "$h" ] && continue
    for i in 1 2 3; do
      for ip in $(getent ahostsv4 "$h" 2>/dev/null | awk '{print $1}' | sort -u); do nft add element inet fomo_egress dyn4 "{ $ip }" 2>/dev/null && n4=$((n4+1)); done
      for ip in $(getent ahostsv6 "$h" 2>/dev/null | awk '$1 ~ /:/ && $1 !~ /^::ffff:/ {print $1}' | sort -u); do nft add element inet fomo_egress dyn6 "{ $ip }" 2>/dev/null && n6=$((n6+1)); done
    done
  done < "$HOSTS"
  echo "refreshed: v4 adds $n4, v6 adds $n6"
}
case "${1:-status}" in
  apply) apply ;;
  refresh) nft list table inet fomo_egress >/dev/null 2>&1 || { apply; exit; }; refresh ;;
  status) nft list chain inet fomo_egress filt | grep -E "counter|reject"; echo "dyn4 $(nft list set inet fomo_egress dyn4 | grep -o 'expires' | wc -l)  dyn6 $(nft list set inet fomo_egress dyn6 | grep -o 'expires' | wc -l)" ;;
  remove) nft delete table inet fomo_egress && echo removed ;;
esac
